# arcane-graph sidecar artifacts — regenerated by tooling/arcane-graph-sidecar/build.sh
# or by the build-graph-sidecar CI workflow. build.rs creates a stub fallback for
# cargo check on fresh clones; the real PyInstaller binary is a build artifact.
src-tauri/binaries/arcane-graph-*
tooling/arcane-graph-sidecar/.venv/
tooling/arcane-graph-sidecar/build/
tooling/arcane-graph-sidecar/dist/

# LSP sidecar binaries — regenerated by `bun run build:lsp-sidecars`. Same
# pattern as arcane-graph: build.rs drops a stub on fresh clones so cargo
# check passes; release builds produce real binaries per platform.
src-tauri/binaries/typescript-language-server-*
src-tauri/binaries/pyright-langserver-*

# Unity extension package — the single source of truth lives in the sibling
# `arcane` repo (arcane/arcane-extension, com.arcane.editor). This staging copy is
# regenerated by `bun run sync:bridge` before every tauri dev/build and bundled as
# an app resource. Never edit it here — edit the source in the arcane repo.
/unity-bridge/
