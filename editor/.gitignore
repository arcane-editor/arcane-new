# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# unityide-graph sidecar artifacts — regenerated by tooling/unityide-graph-sidecar/build.sh
# or by the build-graph-sidecar CI workflow. build.rs creates a stub fallback for
# cargo check on fresh clones; the real PyInstaller binary is a build artifact.
src-tauri/binaries/unityide-graph-*
tooling/unityide-graph-sidecar/.venv/
tooling/unityide-graph-sidecar/build/
tooling/unityide-graph-sidecar/dist/

# LSP sidecar binaries — regenerated by `bun run build:lsp-sidecars`. Same
# pattern as unityide-graph: build.rs drops a stub on fresh clones so cargo
# check passes; release builds produce real binaries per platform.
src-tauri/binaries/typescript-language-server-*
src-tauri/binaries/pyright-langserver-*

# Bundled csharp-ls NuGet package — 22 MB, fetched and SHA-512 verified by
# `bun run prepare:csharp-ls`. Vendored into the installer so the C# language
# server can be provisioned offline; regenerated, never committed.
src-tauri/resources/csharp-ls/*.nupkg
src-tauri/resources/csharp-ls/*.part

# Unity extension package — the single source of truth lives in the sibling
# `arcane-extension` package at the repo root (com.unityide.editor). This staging copy is
# regenerated by `bun run sync:bridge` before every tauri dev/build and bundled as
# an app resource. Never edit it here — edit the source in the arcane-extension package.
/unity-bridge/

# Unity eval run output — JSON result dumps from `bun run eval`, one per run.
# Artifacts, not source; commit only curated baselines explicitly if needed.
tooling/unity-eval/results/

# Graphify analysis output — regenerated by the graph sidecar. Was tracked by
# accident (157 files, ~508 brand hits); artifacts, not source.
/graphify-out/
