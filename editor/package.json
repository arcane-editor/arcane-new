{
  "name": "editor",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dev-env": "tsc && vite build --mode development",
    "check:modules": "bun run scripts/check-deep-modules.mjs",
    "check:invoke": "node scripts/check-invoke-args.mjs",
    "sync:bridge": "node scripts/sync-unity-bridge.mjs",
    "sync:icons": "node scripts/sync-material-icons.mjs",
    "preview": "vite preview",
    "build:lsp-sidecars": "bun run scripts/build-lsp-sidecars.ts",
    "tauri": "bun run build:lsp-sidecars && node scripts/tauri.mjs",
    "tauri:dev-app": "bun run tauri dev",
    "tauri:build:dev-app": "bun run build:lsp-sidecars && tauri build --config src-tauri/tauri.dev.conf.json",
    "test": "bun test src",
    "test:isolated": "bun test ./src/stores/search-tab-lifecycle.exec.ts && bun test ./src/stores/search-invalidation.exec.ts",
    "verify:intellisense": "node scripts/verify-csharp-intellisense.mjs",
    "verify": "tsc --noEmit && bun run check:modules && bun run check:invoke && bun test src && bun run test:isolated && (cd src-tauri && cargo test --lib) && bun run verify:intellisense",
    "eval": "bun tooling/unity-eval/run-eval.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@lexical/react": "^0.44.0",
    "@lexical/utils": "^0.44.0",
    "@monaco-editor/react": "^4.7.0",
    "@sinclair/typebox": "^0.34.49",
    "@tanstack/react-virtual": "^3.13.23",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "^6.0.0",
    "allotment": "^1.20.5",
    "diff": "^8.0.4",
    "lexical": "^0.44.0",
    "lucide-react": "^1.7.0",
    "react": "^19.1.0",
    "react-arborist": "^3.4.3",
    "react-dom": "^19.1.0",
    "react-hotkeys-hook": "^5.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@yao-pkg/pkg": "^6.19.0",
    "material-icon-theme": "5.37.0",
    "pyright": "^1.1.405",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-language-server": "^5.1.3",
    "vite": "^7.0.4"
  }
}
