{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcane",
  "version": "../package.json",
  "identifier": "com.inno.editor",
  "build": {
    "beforeDevCommand": "bun run sync:bridge && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run sync:bridge && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "welcome",
        "title": "Arcane",
        "url": "index.html?view=welcome",
        "width": 720,
        "height": 480,
        "minWidth": 600,
        "minHeight": 360,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#13121A"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["arcane"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFN0NFMDI0MUE0N0VCMjUKUldRbDYwY2FKT0I4THJaWG4zRytBeGw0clZUcW1wejA3S1NubzZPU0VxUmpabmJMQTdCYXFleUkK",
      "endpoints": ["https://releases.arcaneai.org/latest/{{target}}-{{arch}}.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": ["binaries/arcane-graph", "binaries/typescript-language-server"],
    "resources": { "../unity-bridge": "unity-bridge" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  }
}
