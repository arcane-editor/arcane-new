{
  "name": "arcane-server",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "test": "vitest run",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply arcane-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply arcane-db --remote",
    "db:migrate:dev:remote": "wrangler d1 migrations apply arcane-db-dev --env dev --remote",
    "db:seed:local": "wrangler d1 execute arcane-db --local --file=migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute arcane-db --remote --file=migrations/0002_seed.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^4",
    "vitest": "~4.1.10",
    "wrangler": "^4.69.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.30",
    "ai": "^6.0.90",
    "hono": "^4.11.9",
    "jose": "^6.1.3",
    "workers-ai-provider": "^3.2.0"
  }
}
