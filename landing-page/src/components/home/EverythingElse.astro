---
/**
 * The tail of the argument, at four rows and no motion.
 *
 * The tag on each cell is the file extension the panel actually opens, not a
 * category name — `.asmdef .shader .hlsl` says more about scope in fourteen
 * characters than "Full project support" does in a paragraph.
 */
const features = [
  {
    tag: '.cs',
    title: 'C# that knows it is Unity',
    body:
      'Unity analyzers, lifecycle markers in the gutter, FormerlySerializedAs generation, and a debugger that attaches to the Editor.',
  },
  {
    tag: '.unity  .prefab  .mat',
    title: 'Scenes and prefabs as structure',
    body: 'Open as a navigable tree. Diffs read as GameObjects and components, not as text.',
  },
  {
    tag: '.asmdef  .shader  .hlsl',
    title: 'The rest of the project',
    body:
      'Assembly definitions, ShaderLab and HLSL are first-class. Meta files stay paired; new files get a valid GUID.',
  },
  {
    tag: 'AI',
    title: 'An agent that knows your project',
    body:
      'A knowledge graph of classes, YAML, input actions and asmdefs — indexed once, queried by the AI instead of guessed at.',
  },
];
---

<section class="lp-shell" style="padding-block:140px 100px">
  <p class="lp-eyebrow" style="margin-bottom:16px">And the rest</p>
  <h2 class="lp-h2" style="margin-bottom:48px;max-width:22ch">
    Everything else we needed it to do.
  </h2>

  <div class="lp-grid">
    {
      features.map((f) => (
        <div class="lp-grid-cell">
          <div style="font-family:var(--mono);font-size:11.5px;color:#8a8f98">{f.tag}</div>
          <div style="font-size:19px;font-weight:500;letter-spacing:-0.02em;color:#e8e6e1">
            {f.title}
          </div>
          <div style="font-size:14.5px;line-height:1.5;color:#8a8f98;text-wrap:pretty">{f.body}</div>
        </div>
      ))
    }
  </div>
</section>
