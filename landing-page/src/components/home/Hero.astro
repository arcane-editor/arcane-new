---
import IdeShowcase from './IdeShowcase.tsx';

// Comment style in this file: JSX-expression comments, not HTML comments —
// Astro passes HTML comments straight through to the page, where visitors read
// them in view-source.
//
// Every figure below is checked against the code, because a credibility strip
// that inflates its own numbers is worse than no strip: 25 is the count of
// Unity-specific agent tools in `unity-tools/index.ts`, 31 is the analyzer rule
// count in `unity-analyzers/rules/`, and 2021.3 is what the Unity package
// declares it supports.
const proof = [
  ['25', 'Unity-specific AI tools'],
  ['31', 'Unity analyzers'],
  ['6', 'formats edited natively'],
  ['2021.3+', 'through Unity 6'],
];
---

<section class="relative overflow-hidden border-b border-border bg-void pb-20 pt-24 sm:pb-24 sm:pt-28">
  {/* Luminance only, no hue: the ground falls away from the product plane,
      which is the app's own recessed-chrome rule rather than a gradient wash. */}
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[720px]"
    style="background:radial-gradient(ellipse 60% 55% at 50% 42%, hsl(250 19% 13% / 0.85) 0%, transparent 72%)"
  >
  </div>

  <div class="container relative mx-auto px-6">
    {/* Centered, deliberately. The copy's job here is to frame a product shot,
        and symmetry is what gives the window the stage. Earlier revisions ran
        this block left-aligned against a narrow two-pane panel, which read
        editorial when it needed to read like a launch. */}
    <div class="mx-auto max-w-[54rem] text-center">
      {/* "The IDE Unity never built" read as a swipe at the engine, and as
          something a marketing department wrote. This is the same claim from
          the inside: the reason a tool like this exists is that the people
          making it hit the wall first. */}
      <h1 class="font-display text-step3 font-semibold leading-[1.04] text-foreground sm:text-step4">
        We wanted a better IDE for Unity. So we built one.
      </h1>

      {/* Still a list, because completeness is the pitch — but the sentence
          before it says WHY the list is that long, which is the part that only
          someone who has shipped in this engine would write. */}
      <p class="mx-auto mt-6 max-w-[62ch] text-step1 leading-relaxed text-muted-foreground">
        Every panel here exists because something in Unity cost us a day. Hierarchy,
        ScriptableObjects, UI canvas, input maps, console, tests and a debugger —
        with an AI wired into the running Editor.
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
        <a
          href="#download"
          class="inline-flex h-12 items-center justify-center rounded-panel bg-primary px-8 text-base font-semibold text-primary-foreground transition-colors duration-150 hover:bg-primary-lit"
        >
          Download for free
        </a>
        <a
          href="/docs/"
          class="text-base font-medium text-foreground/80 underline decoration-border decoration-1 underline-offset-[7px] transition-colors duration-150 hover:text-foreground hover:decoration-primary"
        >
          Read the docs
        </a>
      </div>

      <p class="mt-5 text-mini text-muted-foreground/70">Free plan. Windows and macOS.</p>
    </div>
  </div>

  {/* The window is the hero. Everything above is its caption. */}
  <div class="container relative mx-auto mt-14 px-6 sm:mt-16">
    <IdeShowcase client:load />

    {/* The proof strip sits under the window rather than above it, so it reads
        as a caption on something you have just seen rather than as a claim you
        are asked to take on faith. */}
    <dl
      class="mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-x-6 gap-y-6 border-t border-border pt-8 sm:grid-cols-4"
    >
      {proof.map(([figure, label]) => (
        <div class="text-center">
          <dt class="font-mono text-step1 font-medium tabular-nums text-primary">{figure}</dt>
          <dd class="mt-1 text-micro leading-snug text-muted-foreground">{label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
