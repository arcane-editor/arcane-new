---
const steps = [
  {
    title: "Install ArcaneIDE",
    desc: "Download and install in under a minute on any platform.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>`,
  },
  {
    title: "Open Unity Project",
    desc: "Open your Unity project — Arcane auto-indexes scenes, scripts, and assets.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"/></svg>`,
  },
  {
    title: "Code with AI",
    desc: "Code with an AI that knows your GameObjects, MonoBehaviours, and scene hierarchy.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/></svg>`,
  },
];
---

<section class="relative py-16 sm:py-24 overflow-hidden">
  <div class="container mx-auto px-4">
    <div class="mb-12 sm:mb-16 text-center scroll-reveal">
      <h2 class="mb-4 font-display text-3xl font-bold tracking-tight sm:text-4xl md:text-5xl">
        Up and Running in <span class="text-gradient-orange">3 Steps</span>
      </h2>
      <p class="mx-auto max-w-lg text-muted-foreground text-base sm:text-lg">
        From download to your first AI-powered commit in minutes.
      </p>
    </div>

    <div class="mx-auto max-w-4xl flex flex-col items-center gap-0 md:flex-row md:gap-0 md:items-start">
      {steps.map((step, i) => (
        <div class="flex flex-1 flex-col items-center md:flex-row">
          <div
            class="scroll-reveal-scale flex flex-col items-center text-center"
            style={`transition-delay: ${i * 150}ms;`}
          >
            <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 text-primary border border-primary/20 transition-all hover:bg-primary/20 hover:glow-orange-sm">
              <Fragment set:html={step.icon} />
            </div>
            <div class="mb-1 font-mono text-xs text-primary/60 uppercase tracking-wider">
              Step {i + 1}
            </div>
            <h3 class="mb-2 font-display text-lg font-semibold">{step.title}</h3>
            <p class="max-w-[200px] text-sm text-muted-foreground">{step.desc}</p>
          </div>

          {/* Desktop connector */}
          {i < steps.length - 1 && (
            <div
              class="hidden md:block flex-1 h-px bg-gradient-to-r from-primary/40 to-primary/10 mx-6 mt-8 origin-left scroll-reveal-line-x"
              style={`transition-delay: ${i * 150 + 200}ms;`}
            ></div>
          )}
          {/* Mobile connector */}
          {i < steps.length - 1 && (
            <div
              class="md:hidden w-px h-10 bg-gradient-to-b from-primary/40 to-primary/10 my-2 origin-top scroll-reveal-line-y"
              style={`transition-delay: ${i * 150 + 200}ms;`}
            ></div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
