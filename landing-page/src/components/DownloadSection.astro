---
import { readFileSync } from "node:fs";
import { downloadUrls, manifestUrls, uncachedManifestUrl, unityExtensionUrl, versionFromManifest, type UpdatePlatform } from "../lib/releases";

// Stable "latest" links — the Release workflow uploads each installer to both
// arcane-releases/<tag>/ and arcane-releases/latest/, so these never need editing
// per release.
//
// The channel follows the environment this site was built for: the dev site
// links to the "UnityIDE Dev" installers, never the production ones.
const apiUrl = import.meta.env.PUBLIC_API_URL ?? "";
const isDev = apiUrl.includes("api-dev");
const urls = downloadUrls(apiUrl);
const manifests = manifestUrls(apiUrl);
const unityExtHref = unityExtensionUrl(apiUrl);

/** The version a workspace declares, read from the repo at build time. */
function pkgVersion(workspace: string): string {
  const url = new URL(`../../../${workspace}/package.json`, import.meta.url);
  return JSON.parse(readFileSync(url, "utf8")).version;
}

/** The version in the repo — used when the manifest cannot be reached, so a
 *  network blip during CI degrades to a slightly stale number instead of
 *  failing the site build. */
const fallbackVersion: string = pkgVersion("editor");

/** The Unity plugin has no update manifest to read — it is a UPM tarball, not
 *  a Tauri target — so its own package.json is the only source of truth. It
 *  sat on a hardcoded "v0.0.1" while the package shipped 0.2.0. */
const unityExtVersion: string = pkgVersion("arcane-extension");

/**
 * The version this platform can actually download, read at build time.
 *
 * Reads the same manifest the app's updater polls, so a card cannot advertise
 * a release that was never published — which is exactly how this section sat
 * on a hardcoded "v0.2.0" through two releases. Per-platform rather than one
 * shared number because it is strictly more honest: if a Windows build fails
 * during a release, its card keeps showing what Windows can actually get.
 *
 * Every failure falls back rather than throwing: this runs inside `astro build`.
 */
async function shippedVersion(url: string, platform: UpdatePlatform): Promise<string> {
  try {
    const res = await fetch(uncachedManifestUrl(url));
    if (!res.ok) return fallbackVersion;
    return versionFromManifest(await res.json(), platform) ?? fallbackVersion;
  } catch {
    return fallbackVersion;
  }
}

// The dev channel rebuilds several times a day; a version string there is
// noise, so it keeps the existing "dev build" label.
const macVersion = isDev ? "dev build" : `v${await shippedVersion(manifests.macArm, "darwin-aarch64")}`;
const winVersion = isDev ? "dev build" : `v${await shippedVersion(manifests.windows, "windows-x86_64")}`;
const unityExtLabel = isDev ? "dev build" : `v${unityExtVersion}`;
/**
 * Windows leads. It is the primary and better-tested target — the macOS build
 * is ad-hoc signed and gets less coverage, which is why Beta appears on that
 * card and nowhere else on the site. The previous order put the beta build
 * first purely because "macOS" sorted first in the array.
 *
 * The Unity package sits in the same table rather than in a separate block
 * below, because it is not optional: without it there is no bridge to the
 * running Editor.
 *
 * Icons are gone. They were six hand-inlined SVGs in which macOS and Linux
 * shared the same terminal chevron and Windows used a monitor — decoration
 * that also happened to be wrong.
 */
const platforms = [
  {
    name: "Windows",
    version: winVersion,
    ext: ".exe",
    subtitle: "Windows 10+ (64-bit)",
    href: urls.windows,
  },
  {
    name: "macOS",
    // The only Beta marker left on the site.
    badge: "Beta",
    version: macVersion,
    ext: ".dmg",
    subtitle: "Apple Silicon (M1+)",
    href: urls.macArm,
  },
  {
    name: "Unity package",
    version: unityExtLabel,
    ext: ".tgz",
    subtitle: "Unity 2021.3+ (UPM)",
    href: unityExtHref,
    note: true,
  },
];
---

<section id="download" class="border-b border-border bg-sunk py-16 sm:py-20">
  <div class="container mx-auto px-6">
    <h2 class="font-display text-step2 font-semibold text-foreground">
      Download
    </h2>

    {/* No lede here. A draft of this section carried "We wanted a better IDE for
        Unity. So we built one." as its opening line, which only worked while the
        hero had a different headline. The hero owns that sentence again, and
        saying it twice on one page spends it. */}
    <div class="mt-10 max-w-3xl overflow-hidden rounded-plane border border-border bg-panel">
      {platforms.map((p) => (
        <div class="flex flex-wrap items-center gap-x-4 gap-y-3 border-b border-border px-5 py-4 last:border-b-0 sm:flex-nowrap">
          <div class="flex min-w-0 shrink-0 items-center gap-2.5 sm:w-[176px]">
            <span class="truncate text-base font-semibold text-foreground">{p.name}</span>
            {p.badge && (
              <span class="shrink-0 rounded-chip border border-primary/30 bg-primary/10 px-1.5 py-0.5 font-mono text-[10px] text-primary">
                {p.badge}
              </span>
            )}
          </div>

          <span class="shrink-0 font-mono text-mini text-muted-foreground sm:w-[92px]">
            {p.version}
          </span>

          <span class="min-w-0 flex-1 truncate text-mini text-muted-foreground">
            {p.subtitle}
          </span>

          <a
            href={p.href}
            class="inline-flex h-9 shrink-0 items-center justify-center rounded-panel border border-border bg-raised px-4 font-mono text-mini text-foreground transition-colors hover:border-primary/40 hover:bg-selected hover:text-primary"
          >
            {p.ext}
          </a>
        </div>
      ))}
    </div>

    <p class="mt-5 max-w-3xl text-mini text-muted-foreground">
      Install the Unity package through Package Manager &rarr; Add package from tarball.
      <a
        href="/docs/getting-started/unity-extension/"
        class="text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:decoration-primary"
        >Setup guide</a
      >.
    </p>

    {/* Linux was a full card whose only content was the words "Coming Soon".
        A line states the same fact and stops competing with the builds that
        actually exist. */}
    <p class="mt-2 max-w-3xl text-mini text-muted-foreground">
      Linux is not built yet.
    </p>
  </div>
</section>
