---
import {
  downloadUrls,
  manifestUrls,
  uncachedManifestUrl,
  unityExtensionUrl,
  versionFromManifest,
  type UpdatePlatform,
} from "../lib/releases";
import { readFileSync } from "node:fs";

/**
 * Download, as the two steps it actually is.
 *
 * The IDE on its own does about as much as any other editor: everything this
 * page spent six chapters on needs the bridge package in the project too. The
 * old single table listed the .tgz as a third platform card, which read as
 * optional. Numbering the two steps is not decoration here — the second one
 * genuinely does not work before the first.
 *
 * Channel and version handling is unchanged: the dev site must never hand out
 * production installers, and a card must never advertise a release that was
 * never published.
 */
const apiUrl = import.meta.env.PUBLIC_API_URL ?? "";
const isDev = apiUrl.includes("api-dev");
const urls = downloadUrls(apiUrl);
const manifests = manifestUrls(apiUrl);
const unityExtHref = unityExtensionUrl(apiUrl);

/** The version a workspace declares, read from the repo at build time. */
function pkgVersion(workspace: string): string {
  const url = new URL(`../../../${workspace}/package.json`, import.meta.url);
  return JSON.parse(readFileSync(url, "utf8")).version;
}

/** Used when a manifest cannot be reached, so a network blip during CI
 *  degrades to a slightly stale number instead of failing the site build. */
const fallbackVersion: string = pkgVersion("editor");

/** The Unity plugin is a UPM tarball, not a Tauri target — it has no update
 *  manifest, so its own package.json is the only source of truth. */
const unityExtVersion: string = pkgVersion("arcane-extension");

/** Reads the same manifest the app's updater polls. Every failure falls back
 *  rather than throwing: this runs inside `astro build`. */
async function shippedVersion(url: string, platform: UpdatePlatform): Promise<string> {
  try {
    const res = await fetch(uncachedManifestUrl(url));
    if (!res.ok) return fallbackVersion;
    return versionFromManifest(await res.json(), platform) ?? fallbackVersion;
  } catch {
    return fallbackVersion;
  }
}

// The dev channel rebuilds several times a day; a version string there is noise.
const macVersion = isDev ? "dev build" : `v${await shippedVersion(manifests.macArm, "darwin-aarch64")}`;
const winVersion = isDev ? "dev build" : `v${await shippedVersion(manifests.windows, "windows-x86_64")}`;
const unityExtLabel = isDev ? "dev build" : `v${unityExtVersion}`;

/**
 * Windows leads. It is the primary and better-tested target — the macOS build
 * is ad-hoc signed and gets less coverage, which is why Beta appears on that
 * card and nowhere else on the page.
 */
const platforms = [
  {
    name: "Windows",
    badge: null as string | null,
    subtitle: "Windows 10+ (64-bit)",
    version: winVersion,
    action: "Download .exe",
    href: urls.windows,
  },
  {
    name: "macOS",
    badge: "Beta",
    subtitle: "Apple Silicon (M1+)",
    version: macVersion,
    action: "Download .dmg",
    href: urls.macArm,
  },
];
---

<section id="download" class="lp-shell" style="padding-block:20px 120px;scroll-margin-top:88px">
  <div class="lp-dl">
    <div style="position:relative">
      <h2 class="lp-h2">Try it on the project that cost you a day.</h2>
      <p style="margin:16px 0 0;font-size:16px;color:#8a8f98;max-width:52ch;text-wrap:pretty">
        The IDE is free. Paid plans add AI usage and the bigger reasoning modes —
        <a href="/pricing" style="color:#b4b8c0;border-bottom:1px solid #2a2f37">see pricing</a>.
      </p>
    </div>

    <div
      style="position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;align-items:stretch"
    >
      <div style="display:grid;gap:14px;align-content:start">
        <div style="display:flex;align-items:center;gap:12px">
          <span
            style="width:28px;height:28px;flex:none;border-radius:50%;border:1px solid #2a2f37;background:#151821;display:grid;place-items:center;font-family:var(--mono);font-size:12px;color:#e8e6e1"
            >1</span
          >
          <div>
            <div style="font-size:17px;font-weight:500">Install the IDE on your machine</div>
            <div style="font-size:13px;color:#8a8f98">The desktop app. Pick your OS.</div>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px">
          {
            platforms.map((p) => (
              <a href={p.href} class="lp-dl-card" data-rdt-download={p.name}>
                <span style="font-size:17px;font-weight:500">
                  {p.name}
                  {p.badge && (
                    <span
                      style="font-family:var(--mono);font-size:11px;color:#f5c26b;border:1px solid #3a3320;border-radius:4px;padding:1px 6px;vertical-align:middle;margin-left:6px"
                    >
                      {p.badge}
                    </span>
                  )}
                </span>
                <span style="font-family:var(--mono);font-size:12px;color:#8a8f98">{p.subtitle}</span>
                <span style="font-family:var(--mono);font-size:12px;color:#6f747d">{p.version}</span>
                <span style="font-family:var(--mono);font-size:13px;color:#e8e6e1;margin-top:6px">
                  {p.action} &rarr;
                </span>
              </a>
            ))
          }
        </div>
        <p style="margin:0;font-size:12.5px;color:#6f747d">
          {isDev ? "Dev builds. Linux is not built yet." : "Linux is not built yet."}
        </p>
      </div>

      <div class="lp-dl-step2" style="display:grid;gap:14px;align-content:start">
        <div style="display:flex;align-items:center;gap:12px">
          <span
            style="width:28px;height:28px;flex:none;border-radius:50%;border:1px solid #2a2f37;background:#151821;display:grid;place-items:center;font-family:var(--mono);font-size:12px;color:#e8e6e1"
            >2</span
          >
          <div>
            <div style="font-size:17px;font-weight:500">Then add the bridge to your Unity project</div>
            <div style="font-size:13px;color:#8a8f98">
              A small Editor package. This is what connects the IDE to the running Editor.
            </div>
          </div>
        </div>

        <div
          style="display:grid;gap:12px;padding:18px;border:1px solid #1f2329;border-radius:14px;background:#0a0b0d"
        >
          <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;align-items:baseline">
            <span style="font-family:var(--mono);font-size:13px;color:#e8e6e1">
              {isDev ? "com.unityide.editor.dev" : "com.unityide.editor"}
            </span>
            <span style="font-family:var(--mono);font-size:12px;color:#8a8f98">
              {unityExtLabel} · Unity 2021.3 &rarr; Unity 6
            </span>
          </div>

          <div style="display:grid;gap:8px;font-size:13px;color:#b4b8c0">
            <div style="display:grid;grid-template-columns:16px minmax(0,1fr);gap:8px">
              <span style="color:#6f747d;font-family:var(--mono);font-size:12px">a</span>
              <span>Download the <span style="color:#e8e6e1">.tgz</span> below</span>
            </div>
            <div style="display:grid;grid-template-columns:16px minmax(0,1fr);gap:8px">
              <span style="color:#6f747d;font-family:var(--mono);font-size:12px">b</span>
              <span>
                In Unity:
                <span style="font-family:var(--mono);font-size:12px;color:#e8e6e1"
                  >Window &rarr; Package Manager &rarr; + &rarr; Add package from tarball…</span
                >
              </span>
            </div>
            <div style="display:grid;grid-template-columns:16px minmax(0,1fr);gap:8px">
              <span style="color:#6f747d;font-family:var(--mono);font-size:12px">c</span>
              <span>
                Open the project in UnityIDE — it shows
                <span style="color:#6fe3a5">Connected</span>
              </span>
            </div>
          </div>

          <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:4px">
            <a
              href={unityExtHref}
              class="lp-pill"
              style="color:#0a0b0d;background:#e8e6e1;font-weight:500"
            >
              Download package .tgz &rarr;
            </a>
            <a
              href="/docs/getting-started/unity-extension/"
              class="lp-pill"
              style="color:#b4b8c0;border:1px solid #2a2f37"
            >
              Setup guide
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{/*
  Download clicks, reported to Reddit as `Lead`.

  `Lead` rather than a custom event because Reddit's campaign optimizer works
  against its standard events, and this is the highest-volume signal the funnel
  has — the optimizer needs roughly 50 conversions a week to learn anything, and
  signups alone will not get there for a while. Read it as "clicked download",
  not "installed": the genuine install is a separate custom `Install` event the
  desktop app reports from its first run.

  This is the ONE conversion that fires browser-side, so ad blockers will cost
  some share of it — the numbers here will read lower than reality, and lower
  than server-reported SignUp/Install, by design of the chosen approach.

  The handler never blocks navigation. `rdt` is absent whenever the pixel did
  not load (dev builds, blockers, a failed CDN fetch), so the call is guarded
  and the download proceeds regardless — a tracking failure must never cost
  somebody the product.
*/}
<script>
  import { DOWNLOAD_EVENT } from '../lib/google-tag-manager';
  import { conversionSendTo } from '../lib/google-ads';

  /**
   * One click handler, two destinations.
   *
   * The Reddit half is unchanged. The `dataLayer` push is what lets a Google
   * Ads download conversion be created, relabelled or removed entirely in
   * GTM's UI — a Custom Event trigger on `download` — without another deploy
   * here. That is the point of the container; a GTM install with no dataLayer
   * events can only trigger on URLs and raw click selectors, which break the
   * next time this markup is touched.
   *
   * The listener is registered unconditionally now. It used to hang off
   * `if (rdt)`, so with the Reddit pixel absent — every non-production build,
   * and any browser that blocks it — nothing was bound at all, and the
   * dataLayer push would have been lost with it.
   */
  const w = window as unknown as {
    rdt?: (...args: unknown[]) => void;
    gtag?: (...args: unknown[]) => void;
    dataLayer?: unknown[];
  };

  /**
   * One id per browsing session, shared by every download click within it.
   *
   * Google Ads deduplicates conversions that arrive with a `transaction_id`
   * it has already seen, and the action behind this label counts EVERY
   * conversion. Without an id, the two platform cards sitting side by side
   * make a single person worth two purchases, and an impatient double-click
   * two more — on the metric the campaign bids against.
   *
   * Scoped to the session rather than to the browser on purpose: collapsing
   * one visit is the point, but somebody who comes back weeks later off a
   * fresh ad click is a real second conversion and should count as one.
   */
  function sessionConversionId(): string {
    const KEY = 'unityide.download.conversion';
    try {
      const existing = sessionStorage.getItem(KEY);
      if (existing) return existing;
      const fresh = crypto.randomUUID();
      sessionStorage.setItem(KEY, fresh);
      return fresh;
    } catch {
      // Private mode, or storage blocked. A per-click id still reports the
      // conversion; it just cannot dedupe, which beats not reporting.
      return crypto.randomUUID();
    }
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-rdt-download]').forEach((link) => {
    link.addEventListener('click', () => {
      const platform = link.dataset.rdtDownload;

      try {
        // Seeded defensively rather than assumed: on a build where the tags
        // are gated off, neither gtag nor GTM has created the array, and the
        // push should still be a no-op instead of a TypeError in a click
        // handler that a download depends on.
        (w.dataLayer = w.dataLayer || []).push({
          event: DOWNLOAD_EVENT,
          downloadPlatform: platform,
        });
      } catch {
        // Never let an analytics failure interrupt a download.
      }

      try {
        // The Google Ads conversion, fired straight at gtag rather than left
        // to a GTM tag — one less place the measurement can be switched off
        // by accident. Value and currency are exactly what Google generated
        // for this label; the action values an unpriced conversion at ₹1.
        //
        // No `event_callback`: Google's navigating variant exists for links
        // that unload the page, and these do not — the href is an installer
        // on releases.unityide.app, so the browser downloads it and leaves
        // the page where it is.
        w.gtag?.('event', 'conversion', {
          send_to: conversionSendTo(),
          value: 1.0,
          currency: 'INR',
          transaction_id: sessionConversionId(),
        });
      } catch {
        // Never let an analytics failure interrupt a download.
      }

      try {
        w.rdt?.('track', 'Lead', {
          // Distinguishes Windows from macOS in Events Manager without
          // needing a second event type.
          products: [{ id: platform, name: platform }],
          conversionId: crypto.randomUUID(),
        });
      } catch {
        // Never let an analytics failure interrupt a download.
      }
    });
  });
</script>
