---
const features = [
  {
    title: "AI Context Engine",
    desc: "Your AI understands your entire Unity project — scenes, prefabs, scripts, animators, and their relationships. Multi-phase indexing builds a knowledge graph so every suggestion is project-aware.",
    span: "lg:col-span-2",
    preview: true,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"/><path d="M17.599 6.5a3 3 0 0 0 .399-1.375"/><path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"/><path d="M3.477 10.896a4 4 0 0 1 .585-.396"/><path d="M19.938 10.5a4 4 0 0 1 .585.396"/><path d="M6 18a4 4 0 0 1-1.967-.516"/><path d="M19.967 17.484A4 4 0 0 1 18 18"/></svg>`,
  },
  {
    title: "Unity Editor Integration",
    desc: "Control Play/Pause/Stop, stream console logs, trigger builds, and run tests — all without leaving your code editor.",
    span: "",
    preview: false,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>`,
  },
  {
    title: "C# Code Intelligence",
    desc: "Lifecycle method decorations, serialization analysis, 23+ attribute completions, and safe refactoring tools built for Unity.",
    span: "",
    preview: false,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>`,
  },
  {
    title: "Git & LFS for Unity",
    desc: "One-click Git setup with Unity-optimized .gitignore, .gitattributes, LFS tracking for binary assets, and .meta file validation.",
    span: "lg:col-span-2",
    preview: false,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"/><path d="M12 12v3"/></svg>`,
  },
  {
    title: "Smart File Management",
    desc: "Automatic .meta co-management, special folder badges for Editor/Resources/Plugins, and incremental file watching.",
    span: "",
    preview: false,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"/></svg>`,
  },
  {
    title: "AI Agent Tools",
    desc: "Query your project graph, inspect entities, resolve GUIDs, and get instant project overviews — all via natural language.",
    span: "",
    preview: false,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/></svg>`,
  },
];
---

<section id="features" class="relative py-16 sm:py-28">
  <div class="container mx-auto px-4">
    <div class="mb-12 sm:mb-16 text-center scroll-reveal">
      <h2 class="mb-4 font-display text-3xl font-bold tracking-tight sm:text-4xl md:text-5xl">
        Built for <span class="text-gradient-orange">Unity Developers</span>
      </h2>
      <p class="mx-auto max-w-xl text-muted-foreground text-base sm:text-lg">
        Every feature is designed to streamline your Unity workflow and make game development joyful.
      </p>
    </div>

    <div class="mx-auto max-w-5xl grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((f, i) => (
        <div
          class={`scroll-reveal group relative overflow-hidden rounded-2xl glass p-5 sm:p-6 transition-all duration-300 hover:glow-orange-sm hover:border-primary/30 ${f.span}`}
          style={`transition-delay: ${i * 80}ms;`}
        >
          {/* Hover gradient */}
          <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

          <div class="relative z-10">
            <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary transition-all duration-300 group-hover:bg-primary/20 group-hover:scale-110">
              <Fragment set:html={f.icon} />
            </div>
            <h3 class="mb-2 font-display text-lg font-semibold">{f.title}</h3>
            <p class="text-sm leading-relaxed text-muted-foreground">{f.desc}</p>

            {/* Code preview for AI card */}
            {f.preview && (
              <div class="mt-4 rounded-lg bg-background/60 border border-border/40 p-3 font-mono text-xs">
                <div class="text-muted-foreground">
                  <span class="text-muted-foreground/50">1 </span>
                  <span>void Start() {"{"}</span>
                </div>
                <div class="text-muted-foreground">
                  <span class="text-muted-foreground/50">2 </span>
                  <span>  rb = GetComponent&lt;</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-primary/70">
                    <span class="text-muted-foreground/50">  </span>
                    Rigidbody&gt;();
                  </span>
                  <span class="inline-flex items-center gap-1 rounded bg-primary/15 px-1.5 py-0.5 text-[10px] text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/></svg>
                    AI
                  </span>
                </div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    {/* CTA to full features page */}
    <div class="mt-10 text-center scroll-reveal">
      <a href="/features" class="inline-flex items-center gap-2 text-primary hover:text-primary/80 font-semibold transition-colors group">
        Explore all features
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>
