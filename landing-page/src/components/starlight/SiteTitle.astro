---
/**
 * Starlight's site title, wearing the landing page's face.
 *
 * It used to inline `'Space Grotesk'` and `var(--sl-color-accent)` — a typeface
 * and an accent that exist nowhere else on the site. Both now come from the
 * shared tokens, so the wordmark here and the wordmark in the Navbar are the
 * same mark.
 */
---

<a href="/" class="site-title sl-flex">
  <img src="/icon.png" alt="" width="24" height="24" />
  <span class="wordmark">Unity<b>IDE</b></span>
  <span class="section">Docs</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-family: var(--sans);
    color: var(--text);
  }

  img {
    border-radius: 4px;
  }

  .wordmark {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .wordmark b {
    font-weight: 600;
    color: var(--blue);
  }

  /* Mono, because it names the section you are standing in — the same job the
     breadcrumb under the title does. */
  .section {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--mute);
  }
</style>
