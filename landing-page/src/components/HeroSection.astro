---
import UnityNativePanel from './UnityNativePanel.tsx';

// Comment style in this file: use JSX-expression comments in the template, not
// HTML comments — Astro passes HTML comments straight through to the page,
// where visitors can read them in view-source.
//
// This note lives in the frontmatter on purpose. Written in the template it
// would have to spell out a comment terminator, and that sequence closes the
// enclosing comment early — which is exactly how the text after it ended up
// rendering at the top of the live homepage.
---

{/* min-h-svh, NOT min-h-screen: on mobile `100vh` is the viewport with the
    URL bar *collapsed*, so a 100vh hero is taller than what you can actually
    see and its bottom content sits under the browser chrome until you scroll.
    `svh` is the small-viewport height — the honest one. */}
<section class="relative min-h-svh flex items-center overflow-hidden pt-16">
  {/* Background */}
  <div class="absolute inset-0 bg-grid-pattern opacity-20"></div>
  <div class="absolute inset-0 gradient-mesh"></div>

  {/* Floating code tokens (pure CSS animations) */}
  <span class="absolute bottom-0 font-mono text-sm text-primary/20 select-none pointer-events-none animate-drift" style="left: 10%; animation-duration: 14s; animation-delay: 0s;">{"{}"}</span>
  <span class="absolute bottom-0 font-mono text-sm text-primary/20 select-none pointer-events-none animate-drift" style="left: 25%; animation-duration: 18s; animation-delay: 2s;">{"//"}</span>
  <span class="absolute bottom-0 font-mono text-sm text-primary/20 select-none pointer-events-none animate-drift" style="left: 40%; animation-duration: 12s; animation-delay: 4s;">{"=>"}</span>
  <span class="absolute bottom-0 font-mono text-sm text-primary/20 select-none pointer-events-none animate-drift" style="left: 60%; animation-duration: 16s; animation-delay: 1s;">{"[]"}</span>
  <span class="absolute bottom-0 font-mono text-sm text-primary/20 select-none pointer-events-none animate-drift" style="left: 75%; animation-duration: 15s; animation-delay: 3s;">{"()"}</span>
  <span class="absolute bottom-0 font-mono text-sm text-primary/20 select-none pointer-events-none animate-drift" style="left: 88%; animation-duration: 13s; animation-delay: 5s;">{";;"}</span>
  <span class="absolute bottom-0 font-mono text-sm text-primary/20 select-none pointer-events-none animate-drift" style="left: 50%; animation-duration: 17s; animation-delay: 6s;">{"<>"}</span>

  <div class="container relative z-10 mx-auto px-4 py-12 sm:py-20">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      {/* Left: Text (CSS entrance animations) */}
      <div class="animate-fade-in-left">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs sm:px-4 sm:py-1.5 sm:text-sm font-medium text-primary animate-fade-in-up" style="animation-delay: 0.2s;">
          {/* Sparkles icon (inline SVG) */}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/></svg>
          AI-Powered Unity Development
        </div>

        {/* The H1 leads with the exact phrase this site is trying to rank for.
            It previously read "Code Unity Games Faster / With AI At Your Side" —
            good copy, but it contained neither "IDE" nor the target phrase, on a
            domain that is now literally unityide.app. The gradient treatment
            carries over onto "Unity" so the visual is unchanged. */}
        <h1 class="mb-6 font-display text-3xl font-bold leading-[1.1] tracking-tight sm:text-5xl md:text-6xl lg:text-7xl animate-fade-in-up" style="animation-delay: 0.3s;">
          The IDE for{" "}
          <span class="text-gradient-orange">Unity</span>
          <br />
          <span class="text-muted-foreground/70">Built around the engine</span>
        </h1>

        <p class="mb-8 max-w-lg text-lg leading-relaxed text-muted-foreground animate-fade-in-up" style="animation-delay: 0.4s;">
          A desktop IDE built only for Unity. Scenes, prefabs, ScriptableObjects,
          UI Toolkit and input actions each open as a real editor — and the AI
          reads every one of them, wired straight into the running Unity Editor.
        </p>

        <div class="flex flex-col gap-4 sm:flex-row animate-fade-in-up" style="animation-delay: 0.5s;">
          <a href="#download" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md font-semibold text-sm sm:text-base bg-primary text-primary-foreground hover:bg-primary/90 glow-orange-sm h-11 sm:h-13 px-6 sm:px-8 transition-colors">
            {/* Download icon */}
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1 h-5 w-5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            Download Free
          </a>
          <a href="/docs/" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md font-semibold text-sm sm:text-base border-2 border-primary/50 text-primary hover:bg-primary/10 h-11 sm:h-13 px-6 sm:px-8 transition-colors">
            Read the Docs
            {/* ArrowRight icon */}
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1 h-5 w-5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <p class="mt-6 text-sm text-muted-foreground/60 animate-fade-in-up" style="animation-delay: 0.7s;">
          Free plan · Windows &amp; macOS
        </p>
      </div>

      {/* Right: Mock IDE (React island) */}
      <div class="relative animate-fade-in-right" style="animation-delay: 0.3s;">
        <UnityNativePanel client:load />
      </div>
    </div>
  </div>
</section>
