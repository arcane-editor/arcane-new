---
/**
 * Seven of the twelve links here used to point at `href="#"` — Changelog,
 * Roadmap, About and Careers all labelled "(Coming Soon)", plus Privacy, Terms
 * and two social icons that went nowhere. A link that does nothing is worse
 * than an absent one: it costs a click to discover it is a dead end.
 *
 * They are removed rather than relabelled. Privacy and Terms are the two that
 * should come back, and they need real pages behind them — this site takes
 * live payments.
 *
 * The link data itself moved to `src/lib/site-nav.ts`, which the Navbar and the
 * docs chrome read too. It lived here and in the Navbar separately before, and
 * the two drifted: this file wrote the download target `/#download` and the
 * Navbar wrote `#download`, which is why the nav CTA was dead everywhere but
 * the home page.
 */
import { footerColumns, TRADEMARK_NOTICE } from '../lib/site-nav';

const year = new Date().getFullYear();
---

<footer class="bg-void">
  <div class="container mx-auto px-6 py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-2.5">
          <img src="/icon.png" alt="" class="h-8 w-8" />
          <span class="font-display text-base font-semibold text-foreground">
            Unity<span class="text-primary">IDE</span>
          </span>
        </a>
        <p class="mt-4 max-w-[34ch] text-mini leading-relaxed text-muted-foreground">
          An IDE for Unity, made by people who work in it every day.
        </p>
      </div>

      {footerColumns.map((column) => (
        <div>
          <h2 class="text-mini font-semibold text-foreground">{column.title}</h2>
          <ul class="mt-4 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-mini text-muted-foreground transition-colors hover:text-primary"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-14 border-t border-border pt-6">
      <p class="text-micro text-muted-foreground">
        &copy; {year} UnityIDE
      </p>
      <p class="mt-2 max-w-[72ch] text-micro leading-relaxed text-muted-foreground">
        {TRADEMARK_NOTICE}
      </p>
    </div>
  </div>
</footer>
