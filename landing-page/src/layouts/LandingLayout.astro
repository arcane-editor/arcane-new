---
import '../styles/global.css';
import { isProdChannel } from '../lib/releases';
import { REDDIT_PIXEL_ID } from '../lib/reddit';
import { GOOGLE_ADS_ID, googleTagBootstrap, googleTagSrc } from '../lib/google-ads';
import { GTM_CONTAINER_ID, gtmBootstrap, gtmNoscriptSrc } from '../lib/google-tag-manager';

interface Props {
  // Set to false on auth pages (/auth, /verify, /reset, ...) — those pages
  // carry one-time tokens/codes in the query string and on screen, and
  // Mixpanel's autocapture + session recording would otherwise exfiltrate
  // them to a third party before React ever gets a chance to scrub the URL.
  analytics?: boolean;
  /** Page title. Falls back to the site default. */
  title?: string;
  /** Meta description + og:description. Falls back to the site default. */
  description?: string;
  /** Keep this page out of the index (auth flows, account, admin). */
  noindex?: boolean;
}

const SITE_NAME = 'UnityIDE';
const DEFAULT_TITLE = 'UnityIDE — The First IDE Built Only for Unity Developers';
// "GUID-safe refactors" was removed: there is no project-wide reference-rewriting
// rename engine in the app. `STANDOUT-FEATURES.md` lists it under a recommended
// build order, not as shipped. What replaces it is claimable line by line.
const DEFAULT_DESCRIPTION =
  'The first IDE built only for Unity developers. Prefabs, ScriptableObjects, UI Toolkit and input actions open as real editors, with an AI checked against your running Editor.';

const {
  analytics = true,
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  noindex = false,
} = Astro.props;

// Astro.site comes from `site` in astro.config.mjs. Guarded so a
// misconfiguration degrades to omitting canonical/og:url rather than emitting
// a relative or "undefined/..." URL, which is worse than emitting neither.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og-image.png', Astro.site).href : undefined;

/**
 * SoftwareApplication is the schema Google uses for downloadable dev tools, and
 * it is the highest-leverage structured data available to this site — there was
 * none at all before. `offers` at price 0 is what marks it free during beta;
 * omitting it entirely reads as "price unknown" rather than "free".
 */
/** Same switch the download links read (see `lib/releases.ts`). */
const apiUrlForAdTags = import.meta.env.PUBLIC_API_URL ?? '';

/**
 * The advertising tags — Reddit's pixel and the Google tag — run on
 * production marketing pages only.
 *
 * Two independent gates, for two different reasons:
 *  - `analytics` is the existing third-party-script switch, off on /auth,
 *    /verify, /reset, /account and /admin because those URLs carry one-time
 *    tokens. An ad tag is a third-party script like any other and obeys it.
 *    It matters more for the Google tag than for Reddit's: gtag reports
 *    `page_location`, the FULL current URL, on every page view, so on those
 *    pages it would hand Google a verification code or a password-reset
 *    token as a field of the hit.
 *  - The channel gate exists because there is exactly ONE pixel id and ONE
 *    Ads account for both environments. A dev deploy — or a developer running
 *    this site locally — firing them would report conversions against live ad
 *    spend and quietly mistrain both campaigns' optimizers. `isProdChannel`
 *    is a POSITIVE match on the production API URL for that reason:
 *    `PUBLIC_API_URL` is unset outside the deploy workflow, and anything
 *    phrased as "not dev" would read that empty value as production.
 *
 * The consequence worth knowing: neither tag can be smoke-tested on
 * dev.unityide.app. Verify them on production — Reddit's Pixel Helper or the
 * Conversions API's `test_mode` (which does not count conversions), and
 * Google's Tag Assistant against unityide.app.
 */
const adTags = analytics && isProdChannel(apiUrlForAdTags);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE_NAME,
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Integrated Development Environment',
  operatingSystem: 'macOS, Windows',
  url: Astro.site?.href,
  description: DEFAULT_DESCRIPTION,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Fonts as a <link>, not a CSS @import. An @import inside global.css is
        render-blocking AND serialized behind that stylesheet — the browser
        cannot even discover the font request until the CSS has parsed. Moving
        it here lets the preconnects open both connections during HTML parse. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Two families, not three: Instrument Sans and Geist Mono are the desktop
        app's own UI and editor faces, so the site now reads in the product's
        voice instead of Inter + Space Grotesk + JetBrains Mono. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph — the site emitted none of this before, so every shared link
        rendered as a bare URL with no title, description or image. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    {/* Page-specific head content. The landing page uses this to pull in its
        own two faces (Bricolage Grotesque + IBM Plex Mono) without loading
        them on /features, /pricing, /auth or the docs, which keep the app's
        Instrument Sans and Geist Mono. */}
    <slot name="head" />

    {/* Mixpanel Analytics (marketing pages only — see `analytics` prop) */}
    {analytics && (
      <script type="text/javascript">
        (function(e,c){if(!c.__SV){var l,h;window.mixpanel=c;c._i=[];c.init=function(q,r,f){function t(d,a){var g=a.split(".");2==g.length&&(d=d[g[0]],a=g[1]);d[a]=function(){d.push([a].concat(Array.prototype.slice.call(arguments,0)))}}var b=c;"undefined"!==typeof f?b=c[f]=[]:f="mixpanel";b.people=b.people||[];b.toString=function(d){var a="mixpanel";"mixpanel"!==f&&(a+="."+f);d||(a+=" (stub)");return a};b.people.toString=function(){return b.toString(1)+".people (stub)"};l="disable time_event track track_pageview track_links track_forms track_with_groups add_group set_group remove_group register register_once alias unregister identify name_tag set_config reset opt_in_tracking opt_out_tracking has_opted_in_tracking has_opted_out_tracking clear_opt_in_out_tracking start_batch_senders start_session_recording stop_session_recording people.set people.set_once people.unset people.increment people.append people.union people.track_charge people.clear_charges people.delete_user people.remove".split(" ");
        for(h=0;h<l.length;h++)t(b,l[h]);var n="set set_once union unset remove delete".split(" ");b.get_group=function(){function d(p){a[p]=function(){b.push([g,[p].concat(Array.prototype.slice.call(arguments,0))])}}for(var a={},g=["get_group"].concat(Array.prototype.slice.call(arguments,0)),m=0;m<n.length;m++)d(n[m]);return a};c._i.push([q,r,f])};c.__SV=1.2;var k=e.createElement("script");k.type="text/javascript";k.async=!0;k.src="undefined"!==typeof MIXPANEL_CUSTOM_LIB_URL?MIXPANEL_CUSTOM_LIB_URL:"file:"===
        e.location.protocol&&"//cdn.mxpnl.com/libs/mixpanel-2-latest.min.js".match(/^\/\//)?"https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js":"//cdn.mxpnl.com/libs/mixpanel-2-latest.min.js";e=e.getElementsByTagName("script")[0];e.parentNode.insertBefore(k,e)}})(document,window.mixpanel||[])

        mixpanel.init('3cce2f8da346b2502d479967246fe944', {
          autocapture: true,
          record_sessions_percent: 100,
        })
      </script>
    )}
    {/* Reddit Pixel (production marketing pages only — see `redditPixel`).
        Vendor snippet, kept byte-for-byte as Reddit ships it apart from the
        pixel id being interpolated. Deliberately NO advanced matching in the
        init call: Reddit's own example passes a plaintext email, which would
        put a user's address into page HTML and into a third-party script's
        reach. The same match key is sent SHA-256 hashed from the Worker via
        the Conversions API instead, which Reddit matches identically. */}
    {adTags && (
      <script is:inline define:vars={{ redditPixelId: REDDIT_PIXEL_ID }}>
        !function(w,d){if(!w.rdt){var p=w.rdt=function(){p.sendEvent?p.sendEvent.apply(p,arguments):p.callQueue.push(arguments)};p.callQueue=[];var t=d.createElement("script");t.src="https://www.redditstatic.com/ads/pixel.js?pixel_id="+redditPixelId,t.async=!0;var s=d.getElementsByTagName("script")[0];s.parentNode.insertBefore(t,s)}}(window,document);
        rdt('init', redditPixelId);
        rdt('track', 'PageVisit');
      </script>
    )}

    {/* Google Tag Manager. Gated exactly like the tags below it: the
        container's whole purpose is to carry Google Ads conversion tags, so
        loading it on dev or localhost would fire them against the same live
        Ads account, and loading it on /auth or /verify would expose those
        URLs' one-time tokens to whatever the container is configured to run.

        Kept beside the Google tag rather than at the very top of <head>
        because the rule binding them has to be read as one thing: the code
        owns the `AW-…` destination, the container owns everything built on
        top of it, and a "Google tag" configuration tag for that same id
        inside GTM would double-report every page view. `lib/google-tag-
        manager.ts` has the long version. The snippet is async either way, so
        the position costs nothing measurable. */}
    {adTags && <script is:inline set:html={gtmBootstrap(GTM_CONTAINER_ID)} />}

    {/* Google tag (gtag.js) for the Google Ads account — production
        marketing pages only (see `adTags`). Two elements, exactly as Google
        ships the snippet: the async loader, and an inline bootstrap that
        defines `window.dataLayer` and the `gtag` shim BEFORE gtag.js lands,
        so anything measured during page load is queued instead of dropped.

        `is:inline` is load-bearing on the bootstrap. Without it Astro bundles
        the snippet as an ES module, which both defers it past the loader and
        scopes `gtag` to that module — where no later inline call, and no tag
        Google adds from the Ads UI, can reach it.

        The same pair is injected into the docs pages from `astro.config.mjs`,
        which is why the snippet lives in `lib/google-ads.ts` and is built
        rather than pasted twice. */}
    {adTags && (
      <>
        <script is:inline async src={googleTagSrc(GOOGLE_ADS_ID)}></script>
        <script is:inline set:html={googleTagBootstrap(GOOGLE_ADS_ID)} />
      </>
    )}

    {/* Click-id capture. FIRST-PARTY and therefore unconditional — it runs on
        the auth pages too, where the pixel above deliberately does not. That
        asymmetry is the whole point: signup is the only moment an ad click can
        be bound to an account, and this is how the click id survives the trip
        from the ad landing page to a page no third-party script may touch. */}
    <script>
      import { captureClickId } from '../lib/reddit';
      captureClickId(window.location, document);
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    {/* GTM's no-JavaScript fallback, which Google's install puts immediately
        after <body>. It buys very little — with JS off the container can fire
        only image and iframe tags, so no Ads conversion ever comes through it
        — but Tag Assistant checks for it and it costs one hidden iframe. */}
    {adTags && (
      <noscript>
        <iframe
          src={gtmNoscriptSrc(GTM_CONTAINER_ID)}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
    <slot />

    {/* Scroll reveal observer */}
    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1 }
      );
      if (!reduced) {
        document.querySelectorAll(
          '.scroll-reveal, .scroll-reveal-scale, .scroll-reveal-line-x, .scroll-reveal-line-y'
        ).forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
