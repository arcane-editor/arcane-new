---
import LegalLayout from '../layouts/LegalLayout.astro';

/**
 * Companion to /privacy. Kept deliberately short and specific: a wall of
 * boilerplate that contradicts how the product actually bills or what the AI
 * actually does is worse than no page, because it is the page a reviewer
 * reads when deciding whether this is a legitimate distribution source.
 */
---

