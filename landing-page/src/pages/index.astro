---
import LandingLayout from '../layouts/LandingLayout.astro';
import Navbar from '../components/Navbar.tsx';
import HeroSection from '../components/HeroSection.astro';
import StatsBar from '../components/StatsBar.tsx';
import FeaturesSection from '../components/FeaturesSection.astro';
import HowItWorksSection from '../components/HowItWorksSection.astro';
import DownloadSection from '../components/DownloadSection.astro';
import FeedbackSection from '../components/FeedbackSection.astro';
import DocsSection from '../components/DocsSection.astro';
import Footer from '../components/Footer.astro';
---

<LandingLayout>
  <Navbar client:load />
  <HeroSection />
  <StatsBar client:visible />
  <FeaturesSection />
  <HowItWorksSection />
  <DownloadSection />
  <FeedbackSection />
  <DocsSection />
  <Footer />
</LandingLayout>
