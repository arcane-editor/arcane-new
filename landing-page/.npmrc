# Don't hoist `entities` into the shared pnpm virtual store. Two versions are
# legitimately in the tree — parse5@7 needs entities@6 (has the `./decode`
# export), dom-serializer@2 (via svgo) needs entities@4 — and hoisting picks one,
# which makes parse5 resolve the wrong one and crashes `astro build` with
# ERR_PACKAGE_PATH_NOT_EXPORTED (./decode). Excluding it forces nested,
# per-consumer resolution so each gets the right version.
hoist-pattern[]=*
hoist-pattern[]=!entities
