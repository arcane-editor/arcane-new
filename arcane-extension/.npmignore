# Dev-only files — excluded from npm pack / UPM tarball
install-dev.sh
deploy-prod.sh
.gitignore
.npmignore
.DS_Store
.unityide-dev-path
*.tgz

# Cloudflare Wrangler cache — holds the account id/name, not package content.
# This file exists, so npm ignores .gitignore entirely: the rule has to live
# here or `npm pack` ships .wrangler/cache/wrangler-account.json to every user
# who imports the tarball.
.wrangler/
